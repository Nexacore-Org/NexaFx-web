# Backend API base URL, without a trailing slash.
NEXT_PUBLIC_API_URL=https://nexafx-backend.onrender.com/v1

# Stellar Horizon base URL. Defaults to the public mainnet endpoint.
# Use https://horizon-testnet.stellar.org for testnet.
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# Optional MoonPay publishable API key for the "Buy with card" on-ramp.
# When unset, the option is shown disabled with an explanation.
# NEXT_PUBLIC_MOONPAY_API_KEY=pk_live_xxx
