# Backend API base URL, without a trailing slash.
NEXT_PUBLIC_API_URL=https://nexafx-backend.onrender.com/v1

# Stellar Horizon base URL. Defaults to the public mainnet endpoint.
# Use https://horizon-testnet.stellar.org for testnet.
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# Optional MoonPay publishable API key for the "Buy with card" on-ramp.
# When unset, the option is shown disabled with an explanation.
# NEXT_PUBLIC_MOONPAY_API_KEY=pk_live_xxx

# Feature flags. Leave unset/`false` to hide the corresponding surface.
# Developer page + API key management (backend key endpoints not available yet).
NEXT_PUBLIC_DEVELOPER_ENABLED=false

# Feature flags. Leave unset/`false` to hide the corresponding surface.
# Scheduled and recurring conversions (backend schedule endpoints not available yet).
NEXT_PUBLIC_SCHEDULES_ENABLED=false
# Feature flags (set to "true" to enable the section)
NEXT_PUBLIC_BENEFICIARIES_ENABLED=false
NEXT_PUBLIC_SCHEDULES_ENABLED=false
NEXT_PUBLIC_DEVELOPER_ENABLED=false

# Server-side upstream services
AUTH_API_URL=
EXCHANGE_RATES_API_URL=

# End-to-end tests (Playwright)
E2E_MOCK=false
PLAYWRIGHT_BASE_URL=http://localhost:3000
